# ---------------------------------------------------------------------------
# Vercel production example (Container runtime)
# ---------------------------------------------------------------------------
# Copy these values into Vercel Project Settings -> Environment Variables.
# Generate APP_KEY locally with: php artisan key:generate --show
# Do not commit real credentials.

APP_NAME="Audio Effects Studio"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-project.vercel.app

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stderr
LOG_LEVEL=info

# External MySQL 8+ (PlanetScale, Aiven, AWS RDS, etc.).
# Vercel has no persistent local filesystem, so SQLite cannot be used.
DB_CONNECTION=mysql
DB_HOST=
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
# PlanetScale/Aiven TLS: point this at the container CA bundle.
# MYSQL_ATTR_SSL_CA=/etc/ssl/certs/ca-certificates.crt

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
SESSION_ENCRYPT=false

CACHE_STORE=database
BROADCAST_CONNECTION=log

# S3-compatible private bucket (AWS S3, Cloudflare R2, Supabase Storage, etc.).
FILESYSTEM_DISK=s3
AUDIO_DISK=s3
AUDIO_DIRECT_UPLOAD=true

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-south-1
AWS_BUCKET=
AWS_URL=
# Cloudflare R2 only:
# AWS_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# AWS_USE_PATH_STYLE_ENDPOINT=true

# Vercel functions have a 4.5 MB request body limit. Direct uploads bypass it.
AUDIO_MAX_UPLOAD_MB=10
AUDIO_MAX_FILES_PER_UPLOAD=10
AUDIO_MAX_FILES_PER_USER=100
AUDIO_STORAGE_QUOTA_MB=2048
AUDIO_MAX_DURATION_SECONDS=1800
AUDIO_MAX_CONCURRENT_JOBS=2
AUDIO_LARGE_UPLOAD_THRESHOLD_MB=25
AUDIO_JOB_TIMEOUT=240

# No long-running queue worker is enabled in this Vercel setup.
# Small demos run FFmpeg inside the request. For production, use an external
# worker or a Vercel Daemon, then set QUEUE_CONNECTION=database and
# AUDIO_SYNC_EXPORTS=false.
QUEUE_CONNECTION=sync
AUDIO_SYNC_EXPORTS=true

AUDIO_TEMP_RETENTION_HOURS=1
AUDIO_OUTPUT_RETENTION_HOURS=24
AUDIO_TRASH_RETENTION_HOURS=24

FFMPEG_PATH=/usr/bin/ffmpeg
FFPROBE_PATH=/usr/bin/ffprobe

# Container filesystem is read-only except /tmp. The Dockerfile sets these
# defaults; keep them here so they are explicit in the Vercel dashboard.
LARAVEL_STORAGE_PATH=/tmp/laravel/storage
APP_CONFIG_CACHE=/tmp/laravel/bootstrap/cache/config.php
APP_ROUTES_CACHE=/tmp/laravel/bootstrap/cache/routes-v7.php
APP_EVENTS_CACHE=/tmp/laravel/bootstrap/cache/events.php
APP_PACKAGES_CACHE=/tmp/laravel/bootstrap/cache/packages.php
APP_SERVICES_CACHE=/tmp/laravel/bootstrap/cache/services.php
VIEW_COMPILED_PATH=/tmp/laravel/storage/framework/views

# Set true for the first production deployment, then false afterwards.
RUN_MIGRATIONS=false

VITE_APP_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# TEMPORARY DEMO MODE — SQLite in /tmp + local storage
# ---------------------------------------------------------------------------
# Use this only to preview the UI without external services. The database and
# every uploaded file disappear when the container is replaced or redeployed.
# The 4 MB upload cap stays below Vercel's 4.5 MB request-body limit.
#
# DB_CONNECTION=sqlite
# DB_DATABASE=/tmp/laravel/database.sqlite
# Cookie sessions keep the CSRF token valid across container instances.
# File/database sessions live in /tmp and break when Vercel routes a request
# to a different instance.
# SESSION_DRIVER=cookie
# CACHE_STORE=file
# FILESYSTEM_DISK=local
# AUDIO_DISK=local
# AUDIO_DIRECT_UPLOAD=false
# AUDIO_MAX_UPLOAD_MB=4
# AUDIO_LARGE_UPLOAD_THRESHOLD_MB=3
# AUDIO_STORAGE_QUOTA_MB=512
# AUDIO_MAX_DURATION_SECONDS=600
# RUN_MIGRATIONS=true
